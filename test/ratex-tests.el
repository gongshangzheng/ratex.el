    (insert "price \\$5 and \\\\(x\\\\) and \\(y\\)")
    (let ((fragments (ratex-fragments-in-buffer)))
      (should (= (length fragments) 1))
      (should (equal (plist-get (car fragments) :content) "y")))))

(ert-deftest ratex-fragment-at-point-ignores-escaped-delimiters ()
