(defun ratex-test--make-math-buffer (count)
  "Create a buffer holding COUNT inline and COUNT display formulas."
  (let ((buffer (generate-new-buffer " *ratex-math*")))
    (with-current-buffer buffer
      (dotimes (i count)
        (insert (format "Paragraph %d with inline \\(a_%d^2+b^2\\) math.\n" i i))
        (insert (format "Display \\[\\sum_{k=1}^{%d}\\frac{1}{k^2}\\] here.\n" i)))
      (goto-char (point-min)))
    buffer))

(defun ratex-test--lookup-cost (buffer)
  "Return the best-of-five seconds per fragment lookup in BUFFER."
  (with-current-buffer buffer
    (goto-char (point-max))
    (search-backward "Paragraph")
    (let ((best 1000.0))
      (dotimes (_ 5)
        (let ((start (float-time)))
          (dotimes (_ 20)
            (ratex-fragment-at-point))
          (setq best (min best (/ (- (float-time) start) 20)))))
      best)))

(defun ratex-test--reference-with-delimiters (open close)
  "Old linear lookup, used as the oracle for OPEN/CLOSE around point."
  (save-excursion
    (let ((pos (point))
          (open-len (length open))
          (close-len (length close))
          fragment)
      (while (and (not fragment) (search-backward open nil t))
        (let ((begin (point)))
          (if (or (ratex--escaped-at-p begin)
                  (ratex--code-context-at-p begin))
              (goto-char (max (point-min) (1- begin)))
            (let ((content-begin (+ begin open-len))
                  found-end
                  content-end)
              (goto-char content-begin)
              (while (and (not found-end) (search-forward close nil t))
                (let ((end-start (- (point) close-len)))
                  (unless (or (ratex--escaped-at-p end-start)
                              (ratex--code-context-at-p end-start))
                    (setq found-end (point))
                    (setq content-end end-start))))
              (if (and found-end
                       (<= content-begin pos)
                       (<= pos content-end))
                  (setq fragment
                        (list :begin begin
                              :end found-end
                              :content (buffer-substring-no-properties
                                        content-begin content-end)))
                (goto-char (max (point-min) (1- begin))))))))
      fragment)))

(defun ratex-test--reference-fragment-at-point ()
  "Oracle implementation of the fragment at point (old algorithm)."
  (unless (ratex--code-context-at-p (point))
    (cl-loop for (open . close) in ratex--delimiter-pairs
             for fragment = (ratex-test--reference-with-delimiters open close)
             when fragment return fragment)))

(defun ratex-test--fuzz-insert ()
  "Insert one random chunk of math-like text at point."
  (pcase (random 10)
    (0 (insert "\\("))
    (1 (insert "\\)"))
    (2 (insert "\\["))
    (3 (insert "\\]"))
    (4 (insert "\\\\("))
    (5 (insert "x"))
    (6 (insert "\n"))
    (7 (insert "a^2"))
    (8 (insert " "))
    (9 (insert "\\\\["))))

(ert-deftest ratex-fragment-at-point-matches-reference-implementation ()
  (let ((mismatches 0)
        (checked 0))
    (random "ratex-fuzz")
    (dotimes (_ 40)
      (with-temp-buffer
        (dotimes (_ (1+ (random 30)))
          (ratex-test--fuzz-insert))
        (emacs-lisp-mode)
        (dotimes (offset (min 150 (buffer-size)))
          (goto-char (1+ offset))
          (let ((new (ratex-fragment-at-point))
                (old (ratex-test--reference-fragment-at-point)))
            (cl-incf checked)
            (unless (equal (list (plist-get new :begin)
                                 (plist-get new :end)
                                 (plist-get new :content))
                           (list (plist-get old :begin)
                                 (plist-get old :end)
                                 (plist-get old :content)))
              (cl-incf mismatches))))))
    (should (> checked 1000))
    (should (= mismatches 0))))

(ert-deftest ratex-fragment-lookup-cost-does-not-scale-with-buffer-size ()
