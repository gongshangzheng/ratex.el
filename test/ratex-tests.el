        (large (ratex-test--make-math-buffer 3200)))
    (unwind-protect
        (let ((small-cost (ratex-test--lookup-cost small))
              (large-cost (ratex-test--lookup-cost large)))
          (should (< small-cost 0.005))
          (should (< large-cost 0.005))
          (should (< (/ large-cost (max small-cost 1e-6)) 6.0)))
      (kill-buffer small)
      (kill-buffer large))))

